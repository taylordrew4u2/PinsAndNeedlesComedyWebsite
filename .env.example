# Public URL of the live site. Drives canonical URLs, the sitemap and RSS.
NEXT_PUBLIC_SITE_URL=https://pinsandneedlescomedy.com

# --- Required in production. /admin refuses every login without both. ---
# There is no fallback outside development: a password baked into a public
# repository is not a password. Pick something long and unguessable.
ADMIN_PASSWORD=

# Signs the admin session cookie. Independent of the password on purpose, so
# that knowing one does not let anyone forge the other.
# Generate one with:  openssl rand -hex 32
ADMIN_SECRET=

# Storage driver: "fs" (default, writes ./data and ./public/uploads),
# "github", or "blob". Leave unset — it picks "github" when the two
# CONTENT_GITHUB_* values below are set, else "blob" when
# BLOB_READ_WRITE_TOKEN is present, else "fs".
# CONTENT_DRIVER=fs

# --- Option A: GitHub as the content store (free, no card needed) ---
# Keeps content.json and every upload in a small GitHub repo. Two rules:
#   * Use a DIFFERENT repo from the one this site deploys from, or every
#     autosave would trigger a new deployment.
#   * Keep that repo PRIVATE — content.json holds the Instagram token.
#     Uploads are served through this site's /api/media route, so a private
#     repo still works.
# The token is a fine-grained personal access token (github.com/settings/
# tokens?type=beta) scoped to that one repo with Contents: Read and write.
# CONTENT_GITHUB_TOKEN=
# CONTENT_GITHUB_REPO=your-username/your-content-repo
# CONTENT_GITHUB_BRANCH=main
# Only for GitHub Enterprise; leave unset for github.com.
# CONTENT_GITHUB_API=

# --- Option B: Vercel Blob ---
# Set automatically by Vercel when you add a Blob store to the project.
# BLOB_READ_WRITE_TOKEN=

# Powers the "Log in with Instagram" button under Admin -> Reels -> Instagram
# sync. Create a free app at developers.facebook.com, add the Instagram
# product, and set its OAuth redirect URI to:
#   <NEXT_PUBLIC_SITE_URL above>/api/admin/instagram/callback
# Then copy the app's own ID and secret here. Not required for the rest of
# the site to work -- only for pulling reels in automatically.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# --- The AI helpers: pick ONE of the two blocks below ---
# These power every "Write" button in the admin (SEO copy, alt text, captions,
# bios, show blurbs), "New show from flyer" / "Fill in from poster" under
# Admin -> Shows, and "Write a whole post for me" under Admin -> News. Set
# neither and those buttons say so; everything else keeps working.

# Option A: Anthropic. Get a key at console.anthropic.com. Works on Vercel
# with nothing else to run. ANTHROPIC_MODEL overrides the model.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Option B: Ollama — a model on your own machine, no key and no bill.
#
#   1. Install it from ollama.com, then:  ollama serve
#   2. Pull a model to write with:        ollama pull llama3.1:8b
#   3. To read flyers too, pull one that can see:
#                                         ollama pull llama3.2-vision
#   4. Uncomment OLLAMA_URL below and run  npm run dev
#   5. Check it took:                      npm run ai:check
#
# npm run ai:check is also what to run when a Write button says it cannot:
# it names which of the four things is wrong and prints the fix.
#
# Setting OLLAMA_URL is taken as choosing Ollama, so it wins over an
# ANTHROPIC_API_KEY that is also set. AI_PROVIDER=anthropic|ollama overrides
# that if you want to be explicit.
#
# This only works where the site and Ollama run on the same machine: a
# deployment on Vercel cannot reach your laptop. That does not stop you using
# it for the real site, though — with CONTENT_GITHUB_* (or the Blob token) set
# here too, the admin on your machine edits the LIVE content, and a post saved
# there is public seconds later with no deploy. See docs/DEPLOYMENT.md §4,
# "Writing for the live site without a key".
# OLLAMA_URL=http://127.0.0.1:11434
# The everyday model, for writing. This is the default.
# OLLAMA_MODEL=llama3.1:8b
# Only used for asks with a picture; falls back to OLLAMA_MODEL when unset.
# A text-only model will refuse or ignore the flyer.
# OLLAMA_VISION_MODEL=llama3.2-vision
# Tokens of context to load the model with. A whole news post plus the brand
# brief plus a flyer runs past a small window, and the model silently loses
# the beginning of its own instructions. 16384 is the default and the floor.
# OLLAMA_CONTEXT=16384
# How long to wait for an answer. A big model on a modest machine is slow.
# OLLAMA_TIMEOUT_MS=180000

# --- Optional: let people text a decision in, for nothing ---
# Google Voice gives out a free number and will forward every text it receives
# to an email address. It cannot call a webhook, so the site reads that mailbox
# instead: set these three and texted decisions land in the same pile the host
# draws from. Leave them unset and nothing about texting appears anywhere.
#
#   1. Get a number at voice.google.com.
#   2. Settings -> Messages -> turn on "Forward messages to email".
#   3. Make an app password for the receiving Gmail account
#      (myaccount.google.com/apppasswords — needs 2-step verification on).
#   4. Put the number in Admin -> Bad Decisions -> Text-in number so it shows
#      on the page.
#
# The mailbox is checked by the admin's Tonight panel while it is open, which
# is the only hour it matters — a scheduler is the part that is not free.
# INBOX_IMAP_USER=you@gmail.com
# INBOX_IMAP_PASSWORD=
# Defaults are fine for Gmail.
# INBOX_IMAP_HOST=imap.gmail.com
# INBOX_IMAP_PORT=993
# INBOX_IMAP_MAILBOX=INBOX

# --- Optional: the paid alternative ---
# A carrier number that can POST to a webhook drops texts in without the
# mailbox in the middle. Twilio charges about $1.15/month plus a fraction of a
# cent per message. Point its "A message comes in" webhook at
# <NEXT_PUBLIC_SITE_URL>/api/decisions/sms and set the auth token; the route
# refuses every message while this is unset.
# TWILIO_AUTH_TOKEN=
# Only if the deployment answers to more than one hostname.
# TWILIO_WEBHOOK_URL=
